<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackageId>WolverineFx.Dashboard</PackageId>
		<Version>2.0.3</Version>
		<Authors>Hari</Authors>
		<Description>A beautiful and customizable monitoring dashboard for WolverineFx.</Description>
		<PackageTags>monitoring;dashboard;aspnetcore;wolverinefx;ui</PackageTags>
		<PackageProjectUrl>https://github.com/yasarozg/DashboardWolverine</PackageProjectUrl>
		<RepositoryUrl>https://github.com/yasarozg/DashboardWolverine</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The old standalone sample host is not part of the reusable library. -->
		<Compile Remove="Program.cs" />
		<EmbeddedResource Include="wwwroot\**\*" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
