{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WolverineDashboard": {
    "RoutePrefix": "/wolverine-ui",
    "DashboardTitle": "Wolverine Monitoring",
    "DefaultDataEndpoint": "/api/wolverine/stats",
    "EnableAutoRefresh": true,
    "AutoRefreshIntervalSeconds": 60,
    "Schema": "public"
  },
  "ConnectionStrings": {
    "WolverineDb": "Host=localhost;Port=5432;Database=wolverine_db;Username=your_username;Password=your_password"
  }
}
